{
    "name": "tsaiyihua/laravel-pagecache",
    "description": "Page Cache for Laravel",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "cache", "page", "pagecache"],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12|^13",
        "guzzlehttp/guzzle": "^7.2",
        "ext-redis": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "pestphp/pest": "^3.0|^4.4",
        "orchestra/testbench": "^10.0|^11.0"
    },
    "authors": [
        {
            "name": "Yihua Tsai",
            "email": "tsaiyihua@gmail.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "TsaiYiHua\\Cache\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TsaiYiHua\\Cache\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest"
    },
    "extra": {
        "laravel": {
            "providers": [
                "TsaiYiHua\\Cache\\CacheServiceProvider"
            ]
        }
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
